{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMD",
  "version": "0.2.0-spike.1",
  "identifier": "com.chiangyang.tmd.spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/chiangyangNPU/tmd/raw/master/releases/latest.json",
        "https://github.com/ChiangyangNPU/tmd/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3OURCNDlDRTFGMEYxQTcKUldTbjhmRGhuTFNkcDhKN0xSTFpkSE1aWVMyTnBrdjhndzdMbGJKcTFkUlJFOHYzWEw0d1FRU2MK"
    }
  }
}
