{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMD",
  "version": "0.2.4",
  "identifier": "com.chiangyang.tmd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文档（TMD - Type Markdown, Done.）",
        "role": "Editor",
        "rank": "Default",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 源文档",
        "description": "Markdown 源文档（TMD - Type Markdown, Done.）",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/markdown",
        "exportedType": {
          "identifier": "com.chiangyang.tmd.markdown",
          "conformsTo": [
            "public.plain-text"
          ]
        }
      },
      {
        "ext": [
          "txt"
        ],
        "name": "文本文件",
        "description": "纯文本文件（TMD - Type Markdown, Done.）",
        "role": "Editor",
        "rank": "Default",
        "contentTypes": [
          "public.plain-text"
        ]
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/chiangyangNPU/tmd/raw/master/releases/latest.json",
        "https://github.com/ChiangyangNPU/tmd/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3OURCNDlDRTFGMEYxQTcKUldTbjhmRGhuTFNkcDhKN0xSTFpkSE1aWVMyTnBrdjhndzdMbGJKcTFkUlJFOHYzWEw0d1FRU2MK"
    }
  }
}