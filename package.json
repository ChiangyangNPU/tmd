{
  "name": "tmd",
  "private": true,
  "version": "0.1.0",
  "author": "chiangyang",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-export-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icon": "node scripts/make-icon.mjs",
    "cleanup": "bash scripts/cleanup-old-app.sh",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dist:install": "npm run dist:dir && rm -rf /Applications/TMD.app && cp -R release/mac-arm64/TMD.app /Applications/"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@eslint/js": "^10.0.1",
    "@milkdown/kit": "^7.0.0",
    "@milkdown/plugin-diagram": "^7.0.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/plugin-prism": "^7.22.1",
    "@types/markdown-it": "^14.2.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "dom-docx": "1.0.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^11.0.0",
    "prettier": "^3.9.6",
    "refractor": "^5.0.0",
    "remark-frontmatter": "^5.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.chiangyang.tmd",
    "productName": "TMD",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "afterPack": "./scripts/trim-runtime.cjs",
    "files": [
      "dist/**",
      "electron/**",
      "!**/*.map",
      "!**/*.md",
      "!**/License",
      "!**/LICENSE*",
      "!**/docs/**",
      "!**/*.d.ts",
      "!**/vitest.config.*",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.test.js"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitee.com/chiangyangNPU/tmd/raw/main/releases/",
        "channel": "latest"
      },
      {
        "provider": "github",
        "owner": "ChiangyangNPU",
        "repo": "tmd"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "picgo": "^3.0.2"
  }
}
