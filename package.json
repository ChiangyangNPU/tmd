{
  "name": "tmd",
  "private": true,
  "version": "0.2.1",
  "author": "chiangyang",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc && vite build && node scripts/copy-export-assets.mjs",
    "test": "vitest run",
    "notes": "node scripts/extract-release-notes.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cleanup": "bash scripts/cleanup-old-app.sh",
    "preview": "vite preview",
    "dist:tauri": "tauri build",
    "dist:tauri:dir": "tauri build --bundles app",
    "dist:tauri:install": "npm run dist:tauri:dir && rm -rf \"/Applications/TMD.app\" && cp -R src-tauri/target/release/bundle/macos/TMD.app \"/Applications/TMD.app\"",
    "dist:tauri:win": "tauri build --bundles nsis",
    "dist:tauri:win:dir": "tauri build --no-bundle",
    "dist:tauri:win:open": "start \"\" \"src-tauri\\target\\release\\bundle\\nsis\"",
    "dist:tauri:win:signed": "node scripts/tauri-build-signed.mjs -- --bundles nsis",
    "dist:tauri:mac:signed": "node scripts/tauri-build-signed.mjs -- --bundles app,dmg",
    "smoke:tauri": "node scripts/tauri-gui-check.mjs",
    "smoke:mac": "node scripts/tauri-mac-check.mjs",
    "release:gitee": "node scripts/prepare-gitee-release.mjs"
  },
  "releasePublish": {
    "gitee": "https://gitee.com/chiangyangNPU/tmd",
    "github": {
      "owner": "ChiangyangNPU",
      "repo": "tmd"
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "codemirror": "^6.0.2",
    "dom-docx": "1.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^11.0.0",
    "pinyin-pro": "^3.29.4",
    "prettier": "^3.9.6",
    "refractor": "^5.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "mathml2omml": "^0.5.0",
    "sanitize-html": "^2.18.1"
  }
}
